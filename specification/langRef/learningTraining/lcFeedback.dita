<reference id="lcFeedback" xml:lang="en-us">
	<title><xmlelement>lcFeedback</xmlelement></title>
	<shortdesc >The <xmlelement>lcFeedback</xmlelement> element was
		deprecated in DITA version 1.3. It was replaced with the
		<xmlelement>lcFeedback2</xmlelement> element. It was originally intended to provide
		information to the learner about a correct or incorrect response in an assessment
		interaction. </shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>lcFeedback</indexterm>
				<indexterm>learning and training
					elements<indexterm>lcFeedback</indexterm></indexterm>
			</keywords>
		</metadata>
	</prolog>
	<refbody>
		<section conkeyref="content-models-lcFeedback/lcFeedback.element" id="content-model"/>
		


		<section conkeyref="inheritance-lcFeedback/lcFeedback.inheritance" id="inheritance"/>
		<example id="example" otherprops="examples">
			<title>Example</title>
			<codeblock>
. . .
      &lt;lcFeedback>Yes, look to the East.&lt;/lcFeedback>
. . .
  </codeblock>
		</example>
		<section id="attributes">
			<title>Attributes</title>

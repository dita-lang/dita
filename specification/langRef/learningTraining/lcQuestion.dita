<reference id="lcQuestion" xml:lang="en-us">
	<title><xmlelement>lcQuestion</xmlelement></title>
	<shortdesc >The <xmlelement>lcQuestion</xmlelement> element was
		deprecated in DITA version 1.3. It was replaced with the
		<xmlelement>lcQuestion2</xmlelement> element. It was originally intended to ask the
		question in an interaction.</shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>lcQuestion</indexterm>
				<indexterm>learning and training
					elements<indexterm>lcQuestion</indexterm></indexterm>
			</keywords>
		</metadata>
	</prolog>
	<refbody>
		<section conkeyref="content-models-lcQuestion/lcQuestion.element" id="content-model"/>
		


		<section conkeyref="inheritance-lcQuestion/lcQuestion.inheritance" id="inheritance"/>
		<example id="example" otherprops="examples">
			<title>Example</title>
			<codeblock>
    &lt;lcQuestion>Which one of the following is a logo of a Major League Baseball
team? (You may choose more than one.)&lt;/lcQuestion>
  </codeblock>
		</example>
		<section id="attributes">
			<title>Attributes</title>
			<p conref="../../common/conref-attribute.dita#conref-attribute/universal-outputclass"/>
			
		</section>
	</refbody>
</reference>


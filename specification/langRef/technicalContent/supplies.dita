<reference id="supplies" xml:lang="en-us">
<title><xmlelement>supplies</xmlelement></title>
<shortdesc>The <xmlelement>supplies</xmlelement> element contains information
about the supplies or parts that are required to perform a task. These
supplies or parts need to be available prior to beginning the task.
This element either contains children elements that specify particular
supplies or a <xmlelement>nosupply</xmlelement> element that indicates that no supplies
are needed.</shortdesc>
<prolog><metadata>
<keywords><indexterm>supplies</indexterm></keywords>
</metadata></prolog>
<refbody>

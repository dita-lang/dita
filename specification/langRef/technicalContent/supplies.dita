<section conkeyref="inheritance-supplies/supplies.inheritance" id="inheritance"/>
<example id="example" otherprops="examples"><title>Example</title><codeblock><b>&lt;supplies></b>
 &lt;supplyli>
   &lt;supply>gasket&lt;/supply>
   &lt;supply>engine oil&lt;/supply>
 &lt;/supplyli>
<b>&lt;/supplies></b>
</codeblock></example>

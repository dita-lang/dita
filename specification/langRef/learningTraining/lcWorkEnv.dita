<reference id="lcWorkEnv" xml:lang="en-us">
	<title><xmlelement>lcWorkEnv</xmlelement></title>
	<shortdesc>The <xmlelement>lcWorkEnv</xmlelement> describes the working conditions and contexts in which the training will be applied.</shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>lcWorkEnv</indexterm><indexterm>learning and training elements<indexterm>lcWorkEnv</indexterm></indexterm>
			</keywords>
		</metadata>
	</prolog>
	<refbody>
		<section conkeyref="content-models-lcWorkEnv/lcWorkEnv.element" id="content-model"/>
		
		<section conkeyref="inheritance-lcWorkEnv/lcWorkEnv.inheritance" id="inheritance"/>

<example id="example" otherprops="examples">
<title>Example</title>
<codeblock>
      &lt;lcWorkEnv>
        &lt;title>Work Environment&lt;/title>
        &lt;lcWorkEnvDescription>All learners work in a typical office environment.&lt;/lcWorkEnvDescription>
        &lt;lcPlanResources>You need lots of pencils.&lt;/lcPlanResources>
        &lt;lcProcesses>Follow these processes:
          &lt;ul>
            &lt;li>Fill our the pencil request form.&lt;/li>
            &lt;li>Sharpen the pencils as soon as they arrive, to keep them fresh.&lt;/li>
          &lt;/ul>
        &lt;/lcProcesses>
      &lt;/lcWorkEnv>
</codeblock>
</example>
